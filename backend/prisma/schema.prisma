generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String // Cuisson, Froid, Stockage, Préparation, Nettoyage
  brand       String
  price       Float // EUR
  dimensions  String // "L x W x H cm"
  weight      Float // kg
  image       String
  images      String[] @default([])
  specs       Json // { power, certifications, ... }
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([category])
  @@index([brand])
}

model Cart {
  id        String     @id @default(cuid())
  sessionId String     @unique
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  createdAt DateTime @default(now())

  @@unique([cartId, productId])
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  sessionId       String
  customerEmail   String
  customerName    String
  shippingAddress Json
  billingAddress  Json
  items           OrderItem[]
  subtotal        Float
  shipping        Float
  taxes           Float
  totalAmount     Float
  status          String      @default("pending") // pending, paid, failed, shipped, delivered
  stripeSessionId String      @unique // PaymentIntent id
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float // price at time of order
}

model Conversation {
  id        String    @id @default(cuid())
  sessionId String
  messages  Message[]
  createdAt DateTime  @default(now())

  @@index([sessionId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "user" | "assistant"
  content        String
  createdAt      DateTime     @default(now())
}
